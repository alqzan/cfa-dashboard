rules_version = '2';

// CFA Personal Coach v6 — Firestore security rules.
//
// Principle: a signed-in user may only read/write documents under their own
// users/{uid}/** path. No user can ever read or write another user's data,
// and unauthenticated requests are rejected entirely. Deletes are expected
// to be soft (a `deletedAt` field set by the client) so tombstones sync
// correctly across devices, but hard deletes are allowed too since the
// client is the only writer and already enforces its own merge rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Everything else is denied by default (no other top-level collections
    // are used by this app, and no rule above grants access to them).
  }
}
